      "path": "registry/bases/radix/components/button-group/c-button-group-45.tsx",
      "type": "registry:block",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\n\nimport { cn } from \"@/lib/utils\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  ButtonGroup,\n  ButtonGroupText,\n} from \"@/components/ui/button-group\"\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from \"@/components/ui/tooltip\"\nimport { IconPlaceholder } from \"@/components/ui/icon-placeholder\"\n\nconst environments = [\n  {\n    id: \"development\",\n    label: \"Dev\",\n    tooltip: \"Local development environment\",\n    icon: (\n      <IconPlaceholder\n        lucide=\"Code2Icon\"\n        tabler=\"IconCode\"\n        hugeicons=\"Code01Icon\"\n        phosphor=\"CodeIcon\"\n        remixicon=\"RiCodeLine\"\n        aria-hidden=\"true\"\n      />\n    ),\n  },\n  {\n    id: \"staging\",\n    label: \"Staging\",\n    tooltip: \"Pre-production mirror\",\n    icon: (\n      <IconPlaceholder\n        lucide=\"TestTube2Icon\"\n        tabler=\"IconTestPipe\"\n        hugeicons=\"TestTube01Icon\"\n        phosphor=\"TestTubeIcon\"\n        remixicon=\"RiTestTubeLine\"\n        aria-hidden=\"true\"\n      />\n    ),\n  },\n  {\n    id: \"production\",\n    label: \"Production\",\n    tooltip: \"Live environment — affects real users\",\n    icon: (\n      <IconPlaceholder\n        lucide=\"GlobeIcon\"\n        tabler=\"IconWorld\"\n        hugeicons=\"Globe02Icon\"\n        phosphor=\"GlobeIcon\"\n        remixicon=\"RiGlobalLine\"\n        aria-hidden=\"true\"\n      />\n    ),\n  },\n]\n\nexport default function Pattern() {\n  const [active, setActive] = useState(\"development\")\n\n  return (\n    <ButtonGroup>\n      <TooltipProvider>\n        {environments.map((env) => (\n          <Tooltip key={env.id}>\n            <TooltipTrigger asChild>\n              <Button\n                variant=\"outline\"\n                className={cn(active === env.id ? \"bg-muted\" : \"\")}\n                onClick={() => setActive(env.id)}\n              >\n                {env.icon}\n                {env.label}\n              </Button>\n            </TooltipTrigger>\n            <TooltipContent>{env.tooltip}</TooltipContent>\n          </Tooltip>\n        ))}\n        {active === \"production\" ? (\n          <ButtonGroupText className=\"bg-transparent\">\n            <div className=\"bg-success size-1.5 rounded-full\" />\n            <span>Live</span>\n          </ButtonGroupText>\n        ) : null}\n      </TooltipProvider>\n    </ButtonGroup>\n  )\n}\n",
      "target": "components/examples/c-button-group-45.tsx"
    }
  ],
  "meta": {
    "order": 45
  }
}